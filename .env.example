# Supabase client values exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Same values without NEXT_PUBLIC_* for server scripts and tooling.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only values. Never expose these through NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
DATABASE_URL=
MIGRATION_DATABASE_URL=

# One-time setup guard for /setup.
BOOTSTRAP_SETUP_TOKEN=
BOOTSTRAP_ALLOW_REPEAT=false
AUTH_BYPASS_ENABLED=false

# App metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PEAGC
